# Never deploy macOS metadata
.DS_Store
._*

# Repo-only files, not part of the served site.
# data/, partials/ and scripts/ are the sources the .html files are generated
# from (see README.md). The generated HTML is committed and served; these are
# build inputs and must never be published.
.gitignore
scripts/
partials/
data/
build.sh
*.md
